{
    "plugins": ["prettier-plugin-organize-imports"],
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "bracketSpacing": false,
    "printWidth": 120,
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "tabWidth": 2,
                "embeddedLanguageFormatting": "off"
            }
        }
    ]
}
