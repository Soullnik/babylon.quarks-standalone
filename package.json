{
  "name": "babylon-quarks-standalone",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "npm run build --workspace=babylon.quarks",
    "build:examples": "npm run build --workspace=examples",
    "test": "npm run test --workspace=babylon.quarks",
    "capture:previews": "node ./scripts/capture-demo-previews.mjs",
    "check:pack": "node ./scripts/check-pack-contents.mjs",
    "check": "npm run build && npm run test && npm run build:examples && npm run check:pack",
    "examples": "npm run dev --workspace=examples",
    "dev": "npm run examples"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^7.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "rollup": "^4.57.1",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "version": "0.0.1"
}
