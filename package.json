{
    "name": "babylon-quarks-standalone",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples"
    ],
    "scripts": {
        "build:core": "npm run build --workspace=quarks.core",
        "build": "npm run build:core && npm run build --workspace=babylon.quarks",
        "build:editor": "npm run build --workspace=babylon.quarks-editor",
        "build:examples": "npm run build --workspace=examples",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc -p packages/quarks.core/tsconfig.test.json && tsc -p packages/babylon.quarks/tsconfig.test.json && tsc -p packages/babylon.quarks-editor/tsconfig.test.json && tsc -p examples/tsconfig.json",
        "docs": "npm run docs --workspace=babylon.quarks",
        "docs:check": "npm run docs:check --workspace=quarks.core && npm run docs:check --workspace=babylon.quarks && npm run docs:check --workspace=babylon.quarks-editor",
        "capture:previews": "tsx ./scripts/capture-demo-previews.mts",
        "check:pack": "node ./scripts/check-pack-contents.mjs",
        "build:unitypackage": "node ./scripts/build-unitypackage.mjs",
        "test:exporter": "dotnet build \"tools/unity-quarks-exporter/Tests~/NetStandard\" -nologo -v q && dotnet run --project \"tools/unity-quarks-exporter/Tests~\" --",
        "check": "npm run format:check && npm run lint && npm run build && npm run build:editor && npm run docs:check && npm run typecheck && npm run test:coverage && npm run check:smoothness && npm run build:examples && npm run check:pack",
        "examples": "npm run dev --workspace=examples",
        "dev": "npm run examples",
        "validate:shaders": "node ./scripts/validate-shaders.mjs",
        "validate:wgsl": "node ./scripts/validate-shaders.mjs --lang=wgsl",
        "check:demos": "node ./scripts/demo-smoke.mjs",
        "check:smoothness": "tsx ./scripts/smoothness-sweep.mts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 251"
    },
    "engines": {
        "node": "^22.20.0 || >=24.12.0",
        "npm": ">=10.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "playwright": "^1.59.1",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.1.0",
        "rimraf": "^6.1.2",
        "rollup": "^4.57.1",
        "rollup-plugin-dts": "^6.2.1",
        "ts-jest": "^29.4.6",
        "tslib": "^2.8.1",
        "tsx": "^4.20.5",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5"
    },
    "version": "0.27.1",
    "overrides": {
        "test-exclude": {
            "glob": "^13.0.6"
        },
        "jest-environment-jsdom": {
            "jsdom": "^29.1.1"
        }
    }
}
