{
    "name": "babylon-quarks-standalone",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "examples"
    ],
    "scripts": {
        "build:core": "npm run build --workspace=quarks.core",
        "build": "npm run build:core && npm run build --workspace=babylon.quarks",
        "build:editor": "npm run build --workspace=babylon.quarks-editor",
        "build:examples": "npm run build --workspace=examples",
        "test": "npm run test --workspace=quarks.core && npm run test --workspace=babylon.quarks",
        "docs": "npm run docs --workspace=babylon.quarks",
        "capture:previews": "tsx ./scripts/capture-demo-previews.mts",
        "check:pack": "node ./scripts/check-pack-contents.mjs",
        "build:unitypackage": "node ./scripts/build-unitypackage.mjs",
        "check": "npm run build && npm run build:editor && npm run test && npm run check:smoothness && npm run build:examples && npm run check:pack",
        "examples": "npm run dev --workspace=examples",
        "dev": "npm run examples",
        "validate:wgsl": "node ./scripts/validate-wgsl.mjs",
        "check:smoothness": "tsx ./scripts/smoothness-sweep.mts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=20.11.0",
        "npm": ">=10.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/plugin-transform-modules-commonjs": "^7.27.1",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^30.0.0",
        "cross-env": "^7.0.3",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "playwright": "^1.59.1",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.1.0",
        "rimraf": "^6.1.2",
        "rollup": "^4.57.1",
        "rollup-plugin-dts": "^6.2.1",
        "ts-jest": "^29.4.6",
        "tslib": "^2.8.1",
        "tsx": "^4.20.5",
        "typedoc": "^0.28.19",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "version": "0.19.0"
}
