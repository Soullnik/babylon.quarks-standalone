{
  "name": "babylon.quarks-editor",
  "version": "0.17.6",
  "description": "Shuriken-style effect editor for babylon.quarks: headless edit-model core + React module-stack UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soullnik/babylon.quarks-standalone.git"
  },
  "keywords": [
    "babylonjs",
    "particles",
    "vfx",
    "editor",
    "react",
    "quarks"
  ],
  "author": "soullnik <soullnik96@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@babylonjs/core": ">=9.0.0",
    "babylon.quarks": ">=0.17.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3",
    "react-dom": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
