{
    "name": "babylon.quarks-editor",
    "version": "0.27.1",
    "description": "Shuriken-style effect editor for babylon.quarks: headless edit-model core + React module-stack UI",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./session": {
            "types": "./dist/session.d.ts",
            "import": "./dist/session.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc -p tsconfig.json",
        "test": "jest",
        "docs:check": "typedoc --out node_modules/.cache/typedoc-check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Soullnik/babylon.quarks-standalone.git"
    },
    "keywords": [
        "babylonjs",
        "babylon.js",
        "particles",
        "particle-system",
        "particle-editor",
        "vfx",
        "vfx-editor",
        "shuriken",
        "editor",
        "react",
        "quarks"
    ],
    "author": "soullnik <soullnik96@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Soullnik/babylon.quarks-standalone/issues"
    },
    "homepage": "https://github.com/Soullnik/babylon.quarks-standalone#readme",
    "peerDependencies": {
        "@babylonjs/core": "^9.0.0",
        "@babylonjs/materials": "^9.0.0",
        "@heroicons/react": ">=2.0.0",
        "@tanstack/react-virtual": ">=3.0.0",
        "babylon.quarks": "~0.27.0",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "devDependencies": {
        "@babylonjs/materials": "9.31.0",
        "@heroicons/react": "^2.2.0",
        "@tanstack/react-virtual": "^3.14.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "fake-indexeddb": "^6.2.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "rimraf": "^6.0.0",
        "typescript": "^5.9.3"
    }
}
