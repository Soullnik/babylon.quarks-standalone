{
    "name": "quarks.core",
    "version": "1.0.0-rc.1",
    "private": true,
    "description": "The simulation core of babylon.quarks: a fork of the three.quarks core, bundled into babylon.quarks and not published on its own",
    "type": "module",
    "types": "./dist/types/index.d.ts",
    "main": "./dist/quarks.core.cjs",
    "module": "./dist/quarks.core.esm.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/quarks.core.esm.js",
            "require": "./dist/quarks.core.cjs"
        }
    },
    "files": [
        "dist",
        "src",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf dist .rollup.cache tsconfig.tsbuildinfo",
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "cross-env NODE_ENV=production rollup -c",
        "build": "npm run clean && npm run build:types && npm run build:js",
        "test": "jest",
        "docs:check": "typedoc --out node_modules/.cache/typedoc-check",
        "prettier": "prettier --write \"src/**/*.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Soullnik/babylon.quarks-standalone.git",
        "directory": "packages/quarks.core"
    },
    "keywords": [
        "particle",
        "library",
        "3d",
        "game",
        "performance",
        "math"
    ],
    "author": "Alchemist0823 <the.forrest.sun@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Soullnik/babylon.quarks-standalone/issues"
    },
    "homepage": "https://github.com/Soullnik/babylon.quarks-standalone#readme"
}
