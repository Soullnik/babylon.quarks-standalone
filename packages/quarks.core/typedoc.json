{
    "$schema": "https://typedoc.org/schema.json",
    "name": "quarks.core",
    "entryPoints": ["src/index.ts"],
    "excludePrivate": true,
    "excludeInternal": true,
    "validation": {
        "notExported": true,
        "invalidLink": true,
        "notDocumented": true
    },
    "treatWarningsAsErrors": true,
    "plugin": ["../babylon.quarks/typedoc-accessors.mjs"]
}
